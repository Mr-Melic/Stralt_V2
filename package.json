{
  "name": "@caffeine/template-app",
  "type": "module",
  "engines": {
    "node": ">=16.0.0",
    "pnpm": ">=7.0.0",
    "npm": "please use pnpm"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "check": "pnpm -r --if-present run check",
    "fix": "pnpm -r --if-present run fix",
    "gate": "bash scripts/caffeine-import-gate.sh all",
    "gate:frontend": "bash scripts/caffeine-import-gate.sh frontend",
    "gate:backend": "bash scripts/caffeine-import-gate.sh backend",
    "dup-exports": "python3 scripts/check-duplicate-exports.py src/frontend/src",
    "eop-stables": "python3 scripts/check-eop-stables.py",
    "stack-compat": "bash scripts/open-pr-stack-compat.sh --self",
    "bindgen": "caffeine-bindgen --did-file ./src/backend/dist/backend.did --out-dir ./src/frontend/src --actor-interface-file --force"
  },
  "devDependencies": {
    "sharp": "^0.34.4",
    "@dfinity/pic": "^0.23.0"
  },
  "dependencies": {
    "@caffeineai/core-infrastructure": "^0.3.0"
  }
}
